# Dependencies
node_modules/

# Build output
dist/
build/

# Vite cache
.vite/

# Yarn Berry (PnP) — keep only what's needed to bootstrap
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Yarn PnP runtime — regenerated by `yarn install`.
# Swap the comments if you decide to use zero-installs and
# commit .yarn/cache + .pnp.* on purpose.
.pnp.*

# TypeScript incremental build info
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.*
!.env.example

# Motion+ token-gated package download (fetched via scripts/install-motion-plus.sh)
vendor/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
storybook-static/
